{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Native ESM that Node (Nest), bundlers (Next) and Wrangler all understand.
    // Relative imports therefore end in `.js`.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "verbatimModuleSyntax": true,
    // No Node or DOM types: this package must run in the browser, in Nest and in
    // the Worker, so only the ES2023 standard library is available (Phase 2 §2).
    "types": [],
    "noEmit": true
  },
  "include": ["src"]
}
